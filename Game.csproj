<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <UseWPF>true</UseWPF>
    <SpriteForgeNativeDir Condition="'$(SpriteForgeNativeDir)' == ''">$(MSBuildProjectDirectory)\..\build\windows-msvc-debug\release\bin</SpriteForgeNativeDir>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(SpriteForgeNativeDir)')">
    <None Include="$(SpriteForgeNativeDir)\*.dll"
          Link="%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Localization\**\*.cs" />
    <Compile Remove="Tests\**\*.cs" />
    <Compile Remove="Tools\**\*.cs" />
    <ProjectReference Include="Localization\SpriteForge.Game.Localization.csproj" />
  </ItemGroup>

</Project>
