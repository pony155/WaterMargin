<Window x:Class="WaterMargin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:presentation="clr-namespace:WaterMargin.Presentation"
        Title="WaterMargin Renderer Prototype"
        Width="960"
        Height="640"
        MinWidth="900"
        MinHeight="600"
        Background="#161825"
        Foreground="#F4F1DE"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="28"
                       FontWeight="SemiBold"
                       Text="Native engine sprite sheet" />
            <TextBlock Margin="0,8,0,0"
                       Foreground="#B8BDD0"
                       Text="C# submits four 16 × 16 atlas frames to the native SpriteForge.dll renderer." />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,28"
                Background="#11131D"
                BorderBrush="#353B58"
                BorderThickness="1"
                CornerRadius="8"
                ClipToBounds="True">
            <presentation:EngineViewport x:Name="Viewport" />
        </Border>

        <Grid Grid.Row="2">
            <TextBlock x:Name="FrameLabel"
                       VerticalAlignment="Center"
                       Foreground="#8FE1D7"
                       FontFamily="Consolas"
                       FontSize="15" />
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <Button x:Name="PlayPauseButton"
                        MinWidth="110"
                        Padding="14,7"
                        Click="PlayPauseButton_Click"
                        Content="Pause" />
                <Button Margin="12,0,0,0"
                        MinWidth="110"
                        Padding="14,7"
                        Click="StepButton_Click"
                        Content="Step frame" />
                <Button Margin="12,0,0,0"
                        MinWidth="110"
                        Padding="14,7"
                        Click="RestartButton_Click"
                        Content="Restart" />
            </StackPanel>
            <TextBlock HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Foreground="#B8BDD0"
                       Text="D3D12 · nearest · integer fit" />
        </Grid>
    </Grid>
</Window>
